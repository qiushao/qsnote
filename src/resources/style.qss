QWidget { font-family: "PingFang SC", "Microsoft YaHei UI", "Noto Sans CJK SC", sans-serif; font-size: 14px; color: @text; }
QMainWindow, QDialog, QWidget#center, QWidget#emptyState, QWidget#configBody, QWidget#todoListPage { background: @window; }
QWidget#header, QWidget#toolbar, QWidget#dialogBar { background: @surface; border-bottom: 1px solid @border; }
QWidget#leftPanel { background: @panel; }
QWidget#rightPanel, QWidget#tabStrip, QWidget#metadata { background: @panelAlt; }
QWidget#tabStrip, QWidget#metadata { border-bottom: 1px solid @border; }
QWidget#panelHeader { background: transparent; }
QLabel { background: transparent; border: none; }
QLabel[dialogTitle="true"] { font-size: 17px; font-weight: 600; color: @text; }
QWidget#dialogFooter { background: @surface; border-top: 1px solid @border; }
QLabel#appTitle { font-size: 16px; font-weight: 600; color: @text; }
QLabel#sectionTitle { font-size: 13px; font-weight: 600; color: @textSecondary; }
QLabel[dim="true"] { color: @textDim; }
QLabel#emptyTitle { font-size: 22px; font-weight: 600; color: @textStrong; margin-top: 12px; margin-bottom: 4px; }
QLabel#emptyDescription { font-size: 14px; color: @textDim; }
QLabel#emptyShortcut { font-size: 13px; color: @textDim; margin-top: 16px; }
QWidget#statusBar { background: @surface; border-top: 1px solid @borderLight; }
QLabel#status { font-size: 13px; color: @textDim; }
QPushButton#encoding, QPushButton#lineEnding { border: none; border-radius: 4px; padding: 3px 6px; font-size: 13px; color: @textDim; }
QPushButton { border: 1px solid @inputBorder; background: @surface; border-radius: 7px; padding: 6px 12px; font-size: 14px; }
QPushButton:hover { background: @hover; border-color: @hoverBorder; }
QPushButton:pressed { background: @accentWash; }
QPushButton:focus { border-color: @accent; }
QPushButton:disabled { color: @textDisabled; background: @disabledBg; border-color: @borderLight; }
QPushButton[primary="true"] { background: @accent; border-color: @accent; color: @onAccent; }
QPushButton[primary="true"]:hover { background: @accentStrong; border-color: @accentStrong; }
QPushButton[primary="true"]:pressed { background: @accentPressed; border-color: @accentPressed; }
QPushButton[primary="true"]:disabled { background: @border; border-color: @inputBorder; color: @textDim; }
QPushButton[primary="true"]:focus { border-color: @text; }
QDialogButtonBox QPushButton { min-width: 56px; }
QPushButton[iconButton="true"] { border: 1px solid transparent; background: transparent; color: @textSecondary; padding: 5px; min-width: 18px; min-height: 18px; border-radius: 5px; }
QPushButton[iconButton="true"]:hover { background: @accentWash; color: @textStrong; }
QPushButton[windowButton="true"] { border: 1px solid transparent; background: transparent; color: @textDim; padding: 5px 7px; border-radius: 6px; }
QPushButton[windowButton="true"]:hover { background: @hover; color: @text; }
QPushButton#windowClose:hover { background: #e5484d; color: #ffffff; }
QPushButton[tool="true"], QPushButton[mode="true"] { border: 1px solid transparent; background: transparent; color: @textSecondary; padding: 6px 4px; font-size: 14px; border-radius: 5px; }
QPushButton[tool="true"]:hover, QPushButton[mode="true"]:hover { background: @accentFaint; color: @accent; }
QPushButton[mode="true"]:checked { background: @accentWash; color: @accent; }
QPushButton[tool="true"]:disabled { background: transparent; color: @textFaint; }
QPushButton[iconButton="true"]:focus, QPushButton[windowButton="true"]:focus, QPushButton[tool="true"]:focus, QPushButton[mode="true"]:focus { border-color: @accent; }
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox { border: 1px solid @inputBorder; border-radius: 7px; background: @surface; padding: 6px 10px; font-size: 14px; selection-background-color: @accentSoft; selection-color: @text; }
QLineEdit:hover, QComboBox:hover { border-color: @inputHoverBorder; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: @accent; }
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { color: @textDisabled; background: @disabledBg; }
QLineEdit#search { background: @panel; border-color: @borderLight; border-radius: 8px; padding: 7px 10px; }
QLineEdit#search:focus { background: @surface; border-color: @accent; }
QComboBox, QDateEdit { padding-right: 28px; }
QSpinBox, QDoubleSpinBox { padding-right: 28px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; border: none; border-left: 1px solid @border; border-top-right-radius: 7px; margin: 1px 1px 0 0; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; border: none; border-left: 1px solid @border; border-bottom-right-radius: 7px; margin: 0 1px 1px 0; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: @accentSoft; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/icons/up.svg); width: 8px; height: 6px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/icons/caret.svg); width: 8px; height: 6px; }
QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 24px; }
QComboBox::down-arrow, QDateEdit::down-arrow { image: url(:/icons/caret.svg); width: 8px; height: 6px; }
QComboBox QAbstractItemView { background: @surface; border: 1px solid @inputBorder; selection-background-color: @accentSoft; selection-color: @accent; padding: 5px; outline: none; }
QWidget#notebookPicker { background: @panel; border: 1px solid transparent; border-radius: 8px; }
QComboBox#notebooks { background: transparent; border: none; font-weight: 600; }
QComboBox#groupBy, QComboBox#todoStatus { background: transparent; border-color: transparent; color: @textSecondary; padding-top: 4px; padding-bottom: 4px; }
QComboBox#groupBy:hover, QComboBox#todoStatus:hover { background: @hoverSoft; }
QComboBox#groupBy:focus, QComboBox#todoStatus:focus, QComboBox#notebooks:focus { border: 1px solid @accent; }
QTreeWidget { border: none; background: transparent; outline: none; font-size: 14px; }
QTreeWidget::item { min-height: 36px; padding: 2px 9px; border: 1px solid transparent; border-radius: 6px; }
QTreeWidget::item:hover { background: @hoverSoft; }
QTreeWidget::item:selected { background: @accentMuted; color: @accentStrong; }
QTreeWidget::item:focus { border-color: @accentBorder; }
QTreeWidget#noteTree::item, QTreeWidget#outline::item { min-height: 28px; padding: 1px 7px; border: none; border-radius: 0; }
QTreeWidget::branch { background: transparent; }
QTreeWidget#noteTree::branch:has-children:closed { image: url(:/icons/right.svg); }
QTreeWidget#noteTree::branch:has-children:open { image: url(:/icons/down.svg); }
QTreeWidget#outline::branch:has-children:closed { image: url(:/icons/right.svg); }
QTreeWidget#outline::branch:has-children:open { image: url(:/icons/down.svg); }
QTreeWidget#outline { color: @textSecondary; }
QTreeWidget#outline::item { min-height: 28px; }
QTreeWidget#outline::item:selected { color: @accentStrong; }
QTabWidget#editorSettingsTabs::pane { border: none; border-top: 1px solid @border; background: @surface; top: -1px; }
QTabWidget#editorSettingsTabs > QWidget > QWidget { background: @surface; }
QTabBar { background: transparent; }
QTabBar::tab { background: transparent; color: @textDim; border: 1px solid transparent; border-radius: 6px; margin: 0 3px; padding: 6px 12px; font-size: 14px; }
QTabBar::tab:hover { background: @tabHover; color: @textSecondary; }
QTabBar::tab:selected { background: @surface; color: @accentStrong; border-color: @inputBorder; }
QTabBar#noteTabs::tab:selected { border-bottom: 2px solid @accent; }
QPushButton#noteTabClose { padding: 0; min-width: 0; min-height: 0; border-radius: 4px; }
QTextEdit#editor, QTextEdit#inactiveEditor { border: none; background: @window; padding: 8px 12px; selection-background-color: @accentSoft; }
QTextBrowser { border: none; background: @surface; padding: 20px 24px; selection-background-color: @accentSoft; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle { background: @scrollbar; border-radius: 4px; min-height: 28px; min-width: 28px; }
QScrollBar::handle:hover { background: @scrollbarHover; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: @border; }
QSplitter::handle:hover { background: @accentBorder; }
QMenu { background: @surface; border: 1px solid @inputBorder; border-radius: 8px; padding: 6px; font-size: 14px; }
QMenu::item { padding: 7px 16px; border-radius: 5px; }
QMenu::item:selected { background: @accentSoft; color: @accentStrong; }
QMenu::item:disabled { color: @textDisabled; }
QMenu::separator { background: @border; height: 1px; margin: 5px 8px; }
QToolTip { background: @tooltipBg; color: @tooltipText; border: none; border-radius: 5px; padding: 6px 9px; }
QScrollArea { border: none; background: @surface; }
QDialog#settingsDialog { border-radius: 4px; }
QDialog#settingsDialog QWidget#dialogBar { border-top-left-radius: 4px; border-top-right-radius: 4px; }
QDialog#settingsDialog QWidget#dialogFooter { border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
QLabel[heading="true"] { font-weight: 600; border-bottom: 1px solid @border; padding-bottom: 8px; margin-top: 14px; }
QWidget#configBody { background: @panel; }
QWidget#settingsNavigation { background: @panel; }
QTabBar#settingsTabs::tab { padding: 8px 12px; }
QListWidget#siteConfigNavigation { background: @panelAlt; border: none; border-right: 1px solid @cardBorder; padding: 12px 6px; outline: none; }
QListWidget#siteConfigNavigation::item { color: @textDim; padding: 12px 8px; margin: 2px 0; border: none; border-radius: 7px; }
QListWidget#siteConfigNavigation::item:hover { background: @hover; }
QListWidget#siteConfigNavigation::item:selected { background: @accentWash; color: @accentStrong; }
QWidget#siteConfigBody { background: @surface; }
QWidget[configCard="true"] { background: @surface; border: 1px solid @cardBorder; border-radius: 10px; }
QToolButton[modeCard="true"] { border: 1px solid @inputBorder; border-radius: 8px; padding: 14px 8px; background: @surface; color: @text; }
QToolButton[modeCard="true"]:hover { background: @hover; border-color: @hoverBorder; }
QToolButton[modeCard="true"]:checked { border: 2px solid @accent; color: @accent; }
QPushButton#accentSwatch { border: 2px solid transparent; background: transparent; padding: 0; border-radius: 17px; }
QPushButton#accentSwatch:hover { border-color: @hoverBorder; }
QWidget[configCard="true"] QLabel[heading="true"] { font-size: 16px; color: @text; margin-top: 0; padding-bottom: 10px; }
QDialog#siteConfigDialog QWidget[configCard="true"] { border: none; border-radius: 0; }
QListWidget#siteCategories { background: @surface; border: 1px solid @border; border-radius: 7px; outline: none; }
QListWidget#siteCategories::item { background: transparent; padding: 7px 10px; }
QListWidget#siteCategories::item:selected { background: @accentMuted; color: @accentStrong; }
QCheckBox { spacing: 7px; font-size: 14px; }
QTreeWidget#todoList::item { min-height: 38px; border: none; border-radius: 0; }
QCheckBox::indicator, QTreeWidget#todoList::indicator { width: 14px; height: 14px; border: 1px solid @checkBorder; border-radius: 4px; background: @surface; }
QCheckBox::indicator:checked, QTreeWidget#todoList::indicator:checked { background: @accent; border-color: @accent; image: url(:/icons/check.svg); }
QCheckBox::indicator:hover, QCheckBox::indicator:focus { border-color: @accent; }
QCheckBox::indicator:disabled { background: @borderLight; border-color: @inputBorder; }
QLineEdit#todoTitle { font-size: 16px; font-weight: 600; padding: 9px 10px; }
QPlainTextEdit[codeInput="true"] { border: 1px solid @inputBorder; border-radius: 8px; background: @panelAlt; padding: 12px; selection-background-color: @accentSoft; selection-color: @text; }
QPlainTextEdit[codeInput="true"]:focus { border-color: @accent; background: @surface; }
QListWidget#readerHeadingList { border: 1px solid @border; border-radius: 7px; background: @surface; padding: 4px; outline: none; }
QListWidget#readerHeadingList::item { padding: 8px 10px; border-radius: 5px; }
QListWidget#readerHeadingList::item:hover { background: @hover; }
QListWidget#readerHeadingList::item:selected { background: @accentMuted; color: @accentStrong; }
QPlainTextEdit#todoContent { border: 1px solid @inputBorder; border-radius: 8px; background: @surface; padding: 12px; selection-background-color: @accentSoft; }
QPlainTextEdit#todoContent:focus { border-color: @accent; }
