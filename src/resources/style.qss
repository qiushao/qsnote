QWidget { font-family: "Segoe UI", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif; font-size: 14px; color: #303b4a; }
QMainWindow, QDialog, QWidget#center, QWidget#emptyState, QWidget#configBody, QWidget#todoListPage { background: #ffffff; }
QWidget#header, QWidget#toolbar, QWidget#dialogBar { background: #ffffff; border-bottom: 1px solid #e7ebf0; }
QWidget#leftPanel { background: #f5f7fa; }
QWidget#rightPanel, QWidget#tabStrip, QWidget#metadata { background: #fafbfd; }
QWidget#tabStrip, QWidget#metadata { border-bottom: 1px solid #e7ebf0; }
QWidget#panelHeader { background: transparent; }
QLabel { background: transparent; border: none; }
QLabel#appTitle { font-size: 17px; font-weight: 600; color: #263650; }
QLabel#sectionTitle { font-size: 12px; font-weight: 600; color: #66758a; }
QLabel[dim="true"] { color: #758195; }
QLabel#emptyTitle { font-size: 22px; font-weight: 600; color: #35445a; margin-top: 12px; margin-bottom: 4px; }
QLabel#emptyDescription { font-size: 13px; color: #758195; }
QLabel#emptyShortcut { font-size: 12px; color: #758195; margin-top: 16px; }
QLabel#status { background: #ffffff; border-top: 1px solid #edf0f4; font-size: 12px; color: #758195; padding: 6px 20px; }
QPushButton { border: 1px solid #dfe5ed; background: #ffffff; border-radius: 7px; padding: 6px 12px; font-size: 13px; }
QPushButton:hover { background: #f0f4f9; border-color: #cad4e1; }
QPushButton:pressed { background: #e8eef7; }
QPushButton:focus { border-color: #3b6fd4; }
QPushButton:disabled { color: #a0a9b7; background: #f7f8fa; border-color: #edf0f4; }
QPushButton[primary="true"] { background: #3b6fd4; border-color: #3b6fd4; color: #ffffff; }
QPushButton[primary="true"]:hover { background: #315fb8; border-color: #315fb8; }
QPushButton[iconButton="true"] { border: 1px solid transparent; background: transparent; color: #66758a; padding: 5px; min-width: 18px; min-height: 18px; font-size: 18px; }
QPushButton[iconButton="true"]:hover { background: #e8eef7; color: #35445a; }
QPushButton[windowButton="true"] { border: 1px solid transparent; background: transparent; color: #758195; padding: 4px 10px; font-size: 15px; border-radius: 6px; }
QPushButton[windowButton="true"]:hover { background: #f0f4f9; color: #303b4a; }
QPushButton#windowClose:hover { background: #e5484d; color: #ffffff; }
QPushButton[tool="true"] { border: 1px solid transparent; background: transparent; color: #526176; padding: 5px 7px; font-size: 13px; border-radius: 5px; }
QPushButton[tool="true"]:hover { background: #eef3fb; color: #3b6fd4; }
QPushButton#toolB { font-weight: 700; }
QWidget#viewModes { background: #f0f3f8; border-radius: 7px; }
QPushButton[mode="true"] { background: transparent; border: 1px solid transparent; border-radius: 5px; color: #66758a; padding: 4px 10px; }
QPushButton[mode="true"]:hover { color: #3b6fd4; background: #e8eef7; }
QPushButton[mode="true"]:checked { background: #ffffff; border-color: #dfe5ed; color: #3b6fd4; font-weight: 600; }
QPushButton[iconButton="true"]:focus, QPushButton[windowButton="true"]:focus, QPushButton[tool="true"]:focus, QPushButton[mode="true"]:focus { border-color: #3b6fd4; }
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox { border: 1px solid #dfe5ed; border-radius: 7px; background: #ffffff; padding: 6px 10px; font-size: 13px; selection-background-color: #e8effc; selection-color: #303b4a; }
QLineEdit:hover, QComboBox:hover { border-color: #c5cfdd; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #3b6fd4; }
QLineEdit:disabled, QComboBox:disabled { color: #a0a9b7; background: #f7f8fa; }
QLineEdit#search { background: #f5f7fa; border-color: #edf0f4; border-radius: 8px; padding: 7px 10px; }
QLineEdit#search:focus { background: #ffffff; border-color: #3b6fd4; }
QComboBox { padding-right: 24px; }
QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 24px; }
QComboBox::down-arrow, QDateEdit::down-arrow { image: url(:/icons/caret.xpm); width: 8px; height: 6px; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #dfe5ed; selection-background-color: #e8effc; selection-color: #3b6fd4; padding: 5px; outline: none; }
QWidget#notebookPicker { background: #ffffff; border: 1px solid #dfe5ed; border-radius: 8px; }
QComboBox#notebooks { background: transparent; border: none; font-weight: 600; }
QComboBox#groupBy, QComboBox#todoStatus { background: transparent; border-color: transparent; color: #66758a; padding-top: 4px; padding-bottom: 4px; }
QComboBox#groupBy:hover, QComboBox#todoStatus:hover { background: #eaf0f7; }
QComboBox#groupBy:focus, QComboBox#todoStatus:focus, QComboBox#notebooks:focus { border: 1px solid #3b6fd4; }
QTreeWidget { border: none; background: transparent; outline: none; font-size: 13px; }
QTreeWidget::item { min-height: 32px; padding: 1px 7px; border: 1px solid transparent; border-radius: 6px; }
QTreeWidget::item:hover { background: #eaf0f7; }
QTreeWidget::item:selected { background: #e5edfb; color: #315fb8; }
QTreeWidget::item:focus { border-color: #a9bfe8; }
QTreeWidget#noteTree::item, QTreeWidget#outline::item { border: none; border-radius: 0; }
QTreeWidget::branch { background: transparent; }
QTreeWidget#noteTree::branch:has-children:closed { image: url(:/icons/right.xpm); }
QTreeWidget#noteTree::branch:has-children:open { image: url(:/icons/caret.xpm); }
QTreeWidget#outline::item { min-height: 28px; color: #66758a; }
QTreeWidget#outline::item:selected { color: #315fb8; }
QTabBar { background: transparent; }
QTabBar::tab { background: transparent; color: #758195; border: 1px solid transparent; border-radius: 6px; margin: 0 3px; padding: 6px 12px; font-size: 13px; }
QTabBar::tab:hover { background: #eef2f8; color: #526176; }
QTabBar::tab:selected { background: #ffffff; color: #315fb8; border-color: #dfe5ed; }
QTabBar::close-button { image: url(:/icons/close.xpm); subcontrol-position: right; width: 16px; height: 16px; border-radius: 4px; }
QTabBar::close-button:hover { background: #e8eef7; }
QTextEdit#editor, QTextEdit#inactiveEditor { border: none; background: #ffffff; padding: 20px 24px; selection-background-color: #e8effc; }
QTextBrowser { border: none; background: #ffffff; padding: 20px 24px; selection-background-color: #e8effc; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle { background: #d5dce6; border-radius: 4px; min-height: 28px; min-width: 28px; }
QScrollBar::handle:hover { background: #aebbcf; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: #e7ebf0; }
QSplitter::handle:hover { background: #a9bfe8; }
QMenu { background: #ffffff; border: 1px solid #dfe5ed; border-radius: 8px; padding: 6px; font-size: 13px; }
QMenu::item { padding: 7px 16px; border-radius: 5px; }
QMenu::item:selected { background: #e8effc; color: #315fb8; }
QMenu::item:disabled { color: #a0a9b7; }
QMenu::separator { background: #e7ebf0; height: 1px; margin: 5px 8px; }
QToolTip { background: #35445a; color: #ffffff; border: none; padding: 6px 9px; }
QScrollArea { border: none; background: #ffffff; }
QLabel[heading="true"] { font-weight: 600; border-bottom: 1px solid #e7ebf0; padding-bottom: 8px; margin-top: 14px; }
QWidget#configBody { background: #f5f7fa; }
QWidget#siteConfigNavigation { background: #f5f7fa; }
QTabBar#siteConfigTabs::tab { padding: 8px 12px; }
QWidget[configCard="true"] { background: #ffffff; border: 1px solid #e1e7ef; border-radius: 10px; }
QWidget[configCard="true"] QLabel[heading="true"] { font-size: 16px; color: #263650; margin-top: 0; padding-bottom: 10px; }
QListWidget#siteCategories { background: #ffffff; border: 1px solid #e7ebf0; border-radius: 7px; outline: none; }
QListWidget#siteCategories::item { padding: 7px 10px; }
QListWidget#siteCategories::item:selected { background: #e5edfb; color: #315fb8; }
QCheckBox { spacing: 7px; font-size: 13px; }
QTreeWidget#todoList::item { min-height: 38px; }
QCheckBox::indicator, QTreeWidget#todoList::indicator { width: 14px; height: 14px; border: 1px solid #b7c3d4; border-radius: 4px; background: #ffffff; }
QCheckBox::indicator:checked, QTreeWidget#todoList::indicator:checked { background: #3b6fd4; border-color: #3b6fd4; image: url(:/icons/check.xpm); }
QCheckBox::indicator:hover, QCheckBox::indicator:focus { border-color: #3b6fd4; }
QCheckBox::indicator:disabled { background: #edf0f4; border-color: #dfe5ed; }
QLineEdit#todoTitle { font-size: 16px; font-weight: 600; padding: 9px 10px; }
QPlainTextEdit#todoContent { border: 1px solid #dfe5ed; border-radius: 8px; background: #ffffff; padding: 12px; selection-background-color: #e8effc; }
QPlainTextEdit#todoContent:focus { border-color: #3b6fd4; }
