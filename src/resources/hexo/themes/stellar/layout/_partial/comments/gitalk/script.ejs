<% if (page.cmt_rendered) { %>
<script>
utils.css('https://cdn.jsdelivr.net/npm/gitalk@1.6.2/dist/gitalk.css');
Promise.all([
  utils.js('https://cdn.jsdelivr.net/npm/gitalk@1.6.2/dist/gitalk.min.js'),
  utils.js('https://cdn.jsdelivr.net/npm/blueimp-md5@2.10.0/js/md5.min.js')
]).then(() => {
  const settings = <%- JSON.stringify(theme.comment.gitalk).replace(/</g, '\\u003c') %>;
  new Gitalk({clientID: settings.ClientID, clientSecret: settings.ClientSecret,
    repo: settings.repo, owner: settings.owner, admin: [settings.admin],
    id: md5(location.pathname), language: 'zh-CN'}).render('gitalk-container');
});
</script>
<% } %>
